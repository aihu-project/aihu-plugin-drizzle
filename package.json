{
  "name": "@aihu-plugin/drizzle",
  "version": "0.1.7",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "verify:pack": "node scripts/pack-and-verify.mjs"
  },
  "dependencies": {
    "@aihu/server": "^0.6.0"
  },
  "devDependencies": {
    "@aihu/plugin": "^0.1.1",
    "@aihu-plugin/data": "^2.0.5",
    "@types/node": "^22.13.10",
    "rolldown": "^1.0.0-rc.17",
    "rolldown-plugin-dts": "^0.23.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.29.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "description": "Drizzle ORM data adapter for aihu — typed createResource fetchers and defineLoader helpers (Postgres / SQLite / libSQL).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu-plugin-drizzle.git"
  },
  "homepage": "https://github.com/aihu-project/aihu-plugin-drizzle#readme",
  "bugs": "https://github.com/aihu-project/aihu-plugin-drizzle/issues",
  "publishConfig": {
    "access": "public"
  }
}
